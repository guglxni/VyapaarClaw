# ============================================
# VyapaarClaw — Environment Configuration
# ============================================
# Copy to .env and fill in real values:
#   cp .env.example .env

# --- Razorpay X (Sandbox) ---
VYAPAAR_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
VYAPAAR_RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
VYAPAAR_RAZORPAY_WEBHOOK_SECRET=
# Account number from RazorpayX Dashboard > My Account > Banking
# Required for API polling mode (replaces webhooks)
VYAPAAR_RAZORPAY_ACCOUNT_NUMBER=

# --- Google Safe Browsing v4 ---
# Get key: https://console.cloud.google.com/apis/credentials
# Enable: Safe Browsing API
VYAPAAR_GOOGLE_SAFE_BROWSING_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Redis ---
VYAPAAR_REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL ---
VYAPAAR_POSTGRES_DSN=postgresql://vyapaar:changeme@localhost:5432/vyapaar_db
# Docker Compose helper (not read by VyapaarClaw directly)
POSTGRES_PASSWORD=changeme

# --- Slack (Human-in-the-Loop, optional) ---
VYAPAAR_SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx
VYAPAAR_SLACK_CHANNEL_ID=CXXXXXXXXXX
VYAPAAR_SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Slack app metadata (not read by VyapaarClaw directly)
SLACK_TEAM_ID=TXXXXXXXXXX

# --- Telegram (Human-in-the-Loop, alternative to Slack) ---
# Create a bot via @BotFather, get chat_id via @userinfobot
VYAPAAR_TELEGRAM_BOT_TOKEN=
VYAPAAR_TELEGRAM_CHAT_ID=

# --- Server ---
VYAPAAR_HOST=0.0.0.0
VYAPAAR_PORT=8000
VYAPAAR_LOG_LEVEL=INFO

# --- API Polling (replaces webhooks — no tunnel needed) ---
VYAPAAR_POLL_INTERVAL=30
VYAPAAR_AUTO_POLL=false
VYAPAAR_DEV_MODE=false

# ============================================
# Integrations (Phase 2+)
# ============================================

# --- Exa Search (vendor research / adverse media) ---
# Get key: https://dashboard.exa.ai/
VYAPAAR_EXA_API_KEY=

# --- Browserwire (government portal APIs — GST/MCA) ---
VYAPAAR_BROWSERWIRE_URL=
VYAPAAR_BROWSERWIRE_API_KEY=

# --- GSP GST API (production-tier live GSTIN verification) ---
VYAPAAR_GSP_API_URL=
VYAPAAR_GSP_API_KEY=

# --- HyperAPI (invoice OCR / document extraction) ---
VYAPAAR_HYPERAPI_API_KEY=
VYAPAAR_HYPERAPI_BASE_URL=https://api.hyperbots.com

# ============================================
# Governance Pipeline
# ============================================
VYAPAAR_GOVERNANCE_CHECK_GSTIN=true
VYAPAAR_GOVERNANCE_CHECK_IFSC=true
VYAPAAR_GOVERNANCE_CHECK_SANCTIONS=true
VYAPAAR_GOVERNANCE_CHECK_ANOMALY=true
VYAPAAR_GOVERNANCE_LIVE_GST=false

# ============================================
# LLM (LiteLLM — provider-agnostic)
# ============================================
# Any provider: gpt-4o, anthropic/claude-sonnet-4, ollama/llama3, etc.
# See docs/LLM_CONFIGURATION.md for examples
VYAPAAR_LLM_MODEL=gpt-4o
VYAPAAR_LLM_API_KEY=
VYAPAAR_LLM_BASE_URL=
VYAPAAR_LLM_API_VERSION=
VYAPAAR_DELEGATION_LLM_MODEL=openai/gpt-4o-mini

# --- DenchClaw CRM (optional) ---
# https://github.com/DenchHQ/DenchClaw
VYAPAAR_DENCHCLAW_ENABLED=true
VYAPAAR_DENCHCLAW_URL=http://localhost:3100
VYAPAAR_DENCHCLAW_SYNC_AUTO=true

# --- Security Proxy (optional, deterministic controls) ---
VYAPAAR_SECURITY_PROXY_ENABLED=false
VYAPAAR_SECURITY_PROXY_URL=http://localhost:9000
VYAPAAR_POLICY_SET_ID=

# ============================================
# Dual LLM Quarantine Pattern
# ============================================
# Tools that mark context as untrusted
VYAPAAR_TAINT_SOURCES=handle_razorpay_webhook,poll_razorpay_payouts,check_vendor_reputation,verify_vendor_entity,score_transaction_risk
# Tools requiring security LLM validation when tainted
VYAPAAR_DUAL_LLM_TOOLS=poll_razorpay_payouts,score_transaction_risk
# Security LLM (isolated, no context access)
VYAPAAR_SECURITY_LLM_URL=http://localhost:9001/v1
VYAPAAR_SECURITY_LLM_KEY=
VYAPAAR_SECURITY_LLM_MODEL=gpt-4o-mini
VYAPAAR_DUAL_LLM_MAX_ROUNDS=5
VYAPAAR_QUARANTINE_STRICT=true
VYAPAAR_QUARANTINE_AUDIT_LOG=true
